# Maintainer notes — not part of the tracked project
__DEV/

# Rust build output
/target/

# Python packaging and build artefacts. Anchored, because an unanchored rule
# matches a directory of that name at any depth: `build/` quietly ignored
# `crates/valgebra-py/src/build/`, the frontend's test module, and the tree
# compiled here and nowhere else.
/*.egg-info/
/dist/
/build/
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.dylib
*.dll

# Virtual environments, including the one the PyPy lane builds beside it
/.venv/
/.pypy/

# maturin / wheel intermediates, including the PyPy lane's own output
/wheels/
/dist-pypy/

# Built documentation site
/site/

# Tool caches
.pytest_cache/
.ruff_cache/
.ty_cache/
.mypy_cache/
.hypothesis/
.benchmarks/

# Coverage and profiling
.coverage
.coverage.*
htmlcov/
*.profraw
*.profdata

# Editor, agent, and OS
.vscode/settings.json
.idea/
.claude/
*.swp
*~
.DS_Store

# cargo-mutants run output
/mutants.out/
/mutants.out.old/
/walk-mutants/
/core-diff-mutants/
/walk-diff-mutants/
